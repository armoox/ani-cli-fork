version_info() {
    printf "%s\n" "$version_number"
    exit 0
}

update_script() {
    info "[branch:$branch] Checking for Update.."
    update="$(curl --fail-with-body -sL -A "$agent" "https://raw.githubusercontent.com/armoox/ani-cli-fork/$branch/ani-cli")" || die "[branch:$branch] Connection error: $update"
    new_version="$(printf "%s" "$update" | sed -nE 's|^version_number="([^"]+)"$|\1|p')"
    [ -z "$new_version" ] && die "[branch:$branch] Invalid response."
    printf "%s" "$update" | grep -q "^version_number" || die "[branch:$branch] Invalid Response."
    update="$(printf "%s\n" "$update" | diff -u "$0" -)"
    if [ -z "$update" ]; then
        info "[branch:$branch] Script is up to date :) ($version_number)"
    else
        if printf "%s\n" "$update" | patch "$0" -; then
            info "[branch:$branch] Updated: $version_number -> $new_version"
        else
            die "[branch:$branch] Can't update for some reason!"
        fi
    fi
    exit 0
}

# checks if dependencies are present
dep_ch() {
    for dep; do
        command -v "${dep%% *}" >/dev/null || die "Program \"${dep%% *}\" not found. Please install it."
    done
}

dep_ch_failover() {
    [ -z "$1" ] && return 1
    prog=$(printf "%s" "$1" | cut -d"," -f 1)
    rest=$(printf "%s" "$1" | cut -s -d"," -f 2-)
    command -v "$prog" >/dev/null 2>&1 && printf "%s" "$prog" && return 0
    [ -e "$prog" ] && printf "%s" "$prog" && return 0
    dep_ch_failover "$rest"
}

where_iina() {
    [ -e "/Applications/IINA.app/Contents/MacOS/iina-cli" ] && printf "%s" "/Applications/IINA.app/Contents/MacOS/iina-cli" && return 0
    printf "%s" "iina" && return 0
}

where_mpv() {
    command -v "flatpak" >/dev/null && flatpak info io.mpv.Mpv >/dev/null 2>&1 && printf "%s" "flatpak_mpv" && return 0
    printf "%s" "mpv" && return 0
}

cleanup() {
    tput sgr0 2>/dev/null          # clears colors
    rm -f "${histfile}.new" "/tmp/ani-cli-mpv-$$" # remove temp logfile and stale mpv ipc socket
}

# SCRAPING

select_quality() {
    case "$1" in
        best) result=$(printf "%s" "$links" | head -n1) ;;
        worst) result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | tail -n1) ;;
        *) result=$(printf "%s" "$links" | grep -m 1 "$1") ;;
    esac
    [ -z "$result" ] && warn "Specified quality not found, defaulting to best" && result=$(printf "%s" "$links" | head -n1)

    refr_flag="--referrer=https://otakuhg.site/"
    # the shard CDN closes keepalive connections (ffmpeg logs "keepalive request
    # failed" and reconnects), so use http_persistent=0 to open a fresh connection
    # per segment (fast, curl-like) and --cache=yes so mpv greedily pre-buffers the
    # whole episode instead of stuttering. Seeking still works: this stays on the
    # VOD URL and only tunes the prefetcher/connection handling.
    bacc_flag="--cache=yes --stream-lavf-o=http_persistent=0"
    episode=$(printf "%s" "$result" | cut -d'>' -f2)
}

# anineko.to: search, get episodes, extract m3u8
anineko_curl() {
    _ref="${_referer:-https://anineko.to/}"
    $curl_exe -sL -A "$agent" --max-time 15 \
        -H 'Accept-Language: en-US,en;q=0.9' \
        -H 'Accept-Encoding: gzip, deflate' \
        --compressed \
        -H "Referer: ${_ref}" \
        "$@" 2>/dev/null | tr -d '\r'
}

search_anineko() {
    _query="$(printf '%s' "$1" | sed 's/ /+/g')"
    _raw="$(anineko_curl "https://anineko.to/browser?keyword=${_query}")" || die "Search failed: couldn't fetch results from anineko.to (blocked or offline?)"
    printf '%s' "$_raw" | tr '\n' ' ' | sed 's/<a/\n<a/g' \
        | sed -nE 's|.*<a href="/watch/([a-z0-9-]+)"[^>]*>([^<]+)</a>.*|\1\t\2|p'
}

anineko_desc() {
    mal_id=""; seasons=""; seasons_option=""
}

# cache the episode page per anime to avoid refetching for every episode
ep_page=""
ep_page_id=""

anime_episodes_page() {
    _slug="$1"
    if [ "$ep_page_id" != "$_slug" ]; then
        ep_page="$(anineko_curl "https://anineko.to/watch/${_slug}")"
        ep_page_id="$_slug"
    fi
}

episodes_list_anineko() {
    _slug="$1"
    anime_episodes_page "$_slug"
    printf '%s' "$ep_page" | grep -oE "/watch/${_slug}/ep-[0-9]+" \
        | sed -nE "s|/watch/${_slug}/ep-([0-9]+)|\1|p" | sort -n -u
}

# otakuhg (~anineko.to's embed): unpack the packed player JS from an embed page
# (reads the page on stdin, prints the deobfuscated JS on stdout)
otakuhg_unpack() {
    awk '
function baseto36(n,    s) {
    s = ""
    while (1) {
        s = substr("0123456789abcdefghijklmnopqrstuvwxyz", n % 36 + 1, 1) s
        n = int(n / 36)
        if (n == 0) return s
    }
    return s
}
{ html = (html $0) }
END {
    Q = sprintf("%c", 39)
    start = index(html, "eval(function(p,a,c,k,e,d)")
    if (start == 0) exit 1
    rest = substr(html, start)
    call = index(rest, "}(" Q)
    if (call == 0) exit 1
    code_start = call + 3
    code = ""
    len = length(rest)
    i = code_start
    esc = 0
    while (i <= len) {
        c = substr(rest, i, 1)
        if (c == "\\") { code = code c; esc = 1; i++; continue }
        if (c == Q && !esc) break
        code = code c
        esc = 0
        i++
    }
    n = match(substr(rest, i), /^\x27,([0-9]+),([0-9]+),\x27([^\x27]*)\x27\.split\(\x27[|]\x27\)/, m)
    if (n == 0) exit 1
    count = m[2] + 0
    nd = split(m[3], D, "\\|")
    if (m[1] != 36) exit 1
    for (i = count - 1; i >= 1; i--) {
        tok = baseto36(i)
        if (i + 1 > nd) continue
        val = D[i + 1]
        if (val == "") continue
        w = gensub("(^|[^a-zA-Z0-9_])" tok "([^a-zA-Z0-9_]|$)", "\\1" val "\\2", "g", code)
        if (w != "") code = w
    }
    print code
}'
}

get_anineko_m3u8() {
    _slug="$1"
    _ep_no="$2"
    [ "$mode" = "dub" ] && _prefs="dub hsub sub" || _prefs="hsub sub dub"
    _page="$(anineko_curl "https://anineko.to/watch/${_slug}/ep-${_ep_no}")"
    [ -z "$_page" ] && return 1
    # extract data-video URLs from the matching language group
    _group=""
    for _lang in $_prefs; do
        _g="$(printf '%s' "$_page" | tr '\n' ' ' | sed 's/server-items/\nserver-items/g' \
            | sed -nE "s|.*server-items[^>]*data-id=\"${_lang}\"[[:space:]]*>(.*)|\1|p" \
            | sed 's/server-items/\n/g' | head -1)"
        if [ -n "$_g" ]; then
            _group="$_g"
            break
        fi
    done
    [ -z "$_group" ] && return 1
    # otakuhg embed first: hls3 is hosted on a raw-TS shard CDN that plays fine
    # from the CLI; hls4 (same-origin) is the backup source.
    _embed="$(printf '%s' "$_group" | grep -oE 'https://otakuhg\.site/e/[a-z0-9]+' | head -1)"
    if [ -n "$_embed" ]; then
        _embed_page="$(anineko_curl "$_embed")"
        _decoded="$(printf '%s' "$_embed_page" | otakuhg_unpack)"
        _hls_url="$(printf '%s' "$_decoded" | grep -oE '"hls3":"[^"]*"' | head -1 | sed 's|"hls3":"||; s|"$||')"
        [ -z "$_hls_url" ] && _hls_url="$(printf '%s' "$_decoded" | grep -oE '"hls4":"[^"]*"' | head -1 | sed 's|"hls4":"||; s|"$||')"
        if [ -n "$_hls_url" ]; then
            case "$_hls_url" in
                /*) _hls_url="https://otakuhg.site${_hls_url}" ;;
            esac
            _referer="https://otakuhg.site/"
            _m3u8_content="$(anineko_curl "$_hls_url")"
            _referer="https://anineko.to/"
            _m3u8_base="$(printf '%s' "$_hls_url" | sed 's|[^/]*$||')"
            printf '%s' "$_m3u8_content" | grep -q "EXTM3U" || return 1
            printf '%s' "$_m3u8_content" \
                | sed 's|^#EXT-X-STREAM.*x||g; s|,.*|p|g' \
                | sed -E "s@^([^[:space:]]*\.(m3u8|txt))\$@${_m3u8_base}\1@" \
                | sed '/^#/d; $!N; s|\n| >|; /EXT-X-I-FRAME/d' | sort -nr
            return 0
        fi
    fi
    # fallback: vivibebe embed (segments are usually geo/anti-bot blocked, but
    # keep it so a playlist is still produced when no otakuhg embed exists)
    _embed_id="$(printf '%s' "$_group" | grep -oE 'vivibebe\.site/[a-f0-9]+' | head -1 | sed 's|vivibebe\.site/||')"
    [ -z "$_embed_id" ] && return 1
    _embed_page="$(anineko_curl "https://vivibebe.site/${_embed_id}")"
    # extract the master m3u8 URL from the vivibebe embed
    _m3u8_url="$(printf '%s' "$_embed_page" | sed -nE 's|.*src = "([^"]*master\.m3u8)".*|\1|p' | head -1)"
    [ -z "$_m3u8_url" ] && return 1
    _referer="https://vivibebe.site/${_embed_id}"
    _m3u8_content="$(anineko_curl "$_m3u8_url")"
    _referer="https://anineko.to/"
    _m3u8_base="$(printf '%s' "$_m3u8_url" | sed 's|[^/]*$||')"
    printf '%s' "$_m3u8_content" | grep -q "EXTM3U" || return 1
    printf '%s' "$_m3u8_content" \
        | sed 's|^#EXT-X-STREAM.*x||g; s|,.*|p|g' \
        | sed "s|^\([^[:space:]]*\.m3u8\)$|${_m3u8_base}\1|" \
        | sed '/^#/d; $!N; s|\n| >|; /EXT-X-I-FRAME/d' | sort -nr
}

# gets m3u8 stream URL from anineko.to and selects quality
get_episode_url() {
    links=""
    _m3u8="$(get_anineko_m3u8 "$id" "$ep_no")"
    [ -n "$_m3u8" ] && links="$_m3u8"

    select_quality "$quality"
    if printf "%s" "$ep_list" | grep -q "^$ep_no$"; then
        [ -z "$episode" ] && die "Episode is released, but no valid sources!"
    else
        [ -z "$episode" ] && die "Episode not released!"
    fi
}

time_until_next_ep() {
    animeschedule="https://animeschedule.net"
    query="$(printf "%s\n" "$*" | tr ' ' '+')"
    _routes="$(curl --max-time 5 -s -G "$animeschedule/api/v3/anime" --data "q=${query}" | sed 's|"id"|\n|g' | sed -nE 's|.*,"route":"([^"]*)","premier.*|\1|p')"
    for anime in $_routes; do
        data=$(curl --max-time 5 -s "$animeschedule/anime/$anime" | sed '1,/"anime-header-list-buttons-wrapper"/d' | sed -nE 's|.*countdown-time-raw" datetime="([^"]*)".*|Next Raw Release: \1|p;s|.*countdown-time" datetime="([^"]*)".*|Next Sub Release: \1|p;s|.*english-title">([^<]*)<.*|English Title: \1|p;s|.*main-title".*>([^<]*)<.*|Japanese Title: \1|p')
        status="Ongoing"
        color="33"
        printf "%s\n" "$data"
        ! (printf "%s\n" "$data" | grep -q "Next Raw Release:") && status="Finished" && color="32"
        printf "Status:  \033[1;%sm%s\033[0m\n---\n" "$color" "$status"
    done
    exit 0
}

# PLAYING

process_hist_entry() {
    ep_list=$(episodes_list_anineko "$id")
    latest_ep=$(printf "%s\n" "$ep_list" | tail -n1)
    title=$(printf "%s\n" "$title" | sed "s|[0-9]\+ episodes|${latest_ep} episodes|")
    ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}")
    [ -n "$ep_no" ] && printf "%s\t%s - episode %s\n" "$id" "$title" "$ep_no"
    [ -n "$ep_no" ] || printf "%s\t%s - episode %s (up to date)\n" "$id" "$title" "$latest_ep"
}

update_history() {
    _pos="${1:-0}"
    if grep -q "	${id}	" "$histfile"; then
        awk -F'\t' -v OFS='\t' -v id="$id" -v ep_no="$ep_no" -v title="$title" -v pos="$_pos" '
            $2 == id { $1=ep_no; $3=title; $4=pos }
            { print }
        ' "$histfile" >"${histfile}.new"
    else
        cp "$histfile" "${histfile}.new"
        printf "%s\t%s\t%s\t%s\n" "$ep_no" "$id" "$title" "$_pos" >>"${histfile}.new"
    fi
    mv "${histfile}.new" "$histfile"
}

backup_old_hist() {
    backupfile="${histfile}.v4"
    : >"${histfile}.new"
    while IFS='	' read -r _ep _id _title _pos; do
        case "$_id" in
            *-*) printf "%s\t%s\t%s\t%s\n" "$_ep" "$_id" "$_title" "$_pos" >>"${histfile}.new" ;;
            *) printf "%s\t%s\t%s\t%s\n" "$_ep" "$_id" "$_title" "$_pos" >>"$backupfile" ;;
        esac
    done <"$histfile"
    mv "${histfile}.new" "$histfile"
}

get_mpv_position() {
    _socket="/tmp/ani-cli-mpv-$$"
    if [ -S "$_socket" ]; then
        _pos=$(printf '{ "command": ["get_property", "time-pos"] }\n' | socat - UNIX-CONNECT:"$_socket" 2>/dev/null | sed -nE 's|.*"data":([0-9.]+).*|\1|p')
        [ -n "$_pos" ] && printf "%s" "$_pos" && return 0
    fi
    printf "0"
}

# called from the INT/HUP/TERM trap: persist the playback position of a
# running mpv before exiting, without clobbering history when no player is up
save_position_and_cleanup() {
    case "$player_function" in
        mpv*|flatpak_mpv)
            if [ -n "${_mpv_pid:-}" ] && kill -0 "$_mpv_pid" 2>/dev/null; then
                _pos=$(get_mpv_position)
                [ -n "$_pos" ] && [ "$_pos" != "0" ] && update_history "$_pos"
            fi
            ;;
    esac
    cleanup
}

resume_episode() {
    _hist_id="$1"
    _pos=$(grep -F -- "$_hist_id" "$histfile" | cut -f4)
    [ -z "$_pos" ] || [ "$_pos" = "0" ] && return 1
    printf "%.0f" "$_pos"
}

download() {
    _dl_refr="${refr_flag#--referrer=}"
    case $1 in
        *m3u8*|*txt*)
            if command -v "yt-dlp" >/dev/null; then
                yt-dlp --referer "$_dl_refr" "$1" --no-skip-unavailable-fragments --fragment-retries infinite -N 4 -o "$download_dir/$2.mp4" && return 0
                warn "yt-dlp failed, trying ffmpeg"
            fi
            # -extension_picky needs ffmpeg >= 7.1: retry without it on older builds
            if ffmpeg -extension_picky 0 -referer "$_dl_refr" -loglevel error -stats -i "$1" -c copy "$download_dir/$2.mp4" \
                || ffmpeg -referer "$_dl_refr" -loglevel error -stats -i "$1" -c copy "$download_dir/$2.mp4"; then
                return 0
            fi
            # some otakuhg variants name the mpeg-ts segments "*.woff2", which the
            # system ffmpeg's hls demuxer rejects outright; concatenate them with
            # curl (fresh connection per segment, referer set) and remux locally
            case $1 in
                *txt*)
                    warn "ffmpeg can't read this playlist directly; falling back to curl segment download"
                    _tmp_ts="/tmp/ani-cli-$$.ts"
                    _pl_file="/tmp/ani-cli-pl-$$.txt"
                    curl -fsSL --compressed -A "$agent" -H "Referer: $_dl_refr" "$1" | tr -d '\r' > "$_pl_file" || die "download failed: couldn't fetch playlist"
                    _base="$(printf '%s' "$1" | sed 's|[^/]*$||')"
                    while IFS= read -r _seg; do
                        case $_seg in '#'*|'') continue ;;
                        esac
                        _ok=0
                        _try=0
                        while [ "$_ok" = 0 ] && [ "$_try" -lt 5 ]; do
                            _try=$((_try + 1))
                            if ! curl -fsSL --compressed -A "$agent" -H "Referer: $_dl_refr" "${_base}${_seg}" -o "$_tmp_ts.part"; then
                                sleep 2
                                continue
                            fi
                            _sz=$(wc -c < "$_tmp_ts.part" 2>/dev/null || printf "0")
                            # the shard CDN rate-limits request bursts and then answers
                            # with truncated 200 bodies: treat those as failures and back off
                            if [ "${_sz:-0}" -lt 5000 ]; then
                                sleep 2
                                continue
                            fi
                            cat "$_tmp_ts.part" >> "$_tmp_ts"
                            _ok=1
                        done
                        [ "$_ok" = 0 ] && { rm -f "$_tmp_ts" "$_tmp_ts.part" "$_pl_file"; die "download failed on segment $_seg (shard throttled?)"; }
                    done < "$_pl_file"
                    rm -f "$_tmp_ts.part"
                    _sum=$(grep '#EXTINF' "$_pl_file" | sed 's/[^0-9.]//g' | awk '{s+=$1} END {print s + 0}')
                    rm -f "$_pl_file"
                    ffmpeg -loglevel error -y -i "$_tmp_ts" -c copy "$download_dir/$2.mp4"
                    _rc=$?
                    rm -f "$_tmp_ts"
                    [ "$_rc" != 0 ] && die "download failed"
                    if command -v ffprobe >/dev/null 2>&1 && [ -n "${_sum:-}" ] && [ "${_sum:-0}" -gt 0 ]; then
                        _dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$download_dir/$2.mp4" 2>/dev/null | cut -d. -f1)
                        [ -n "${_dur:-}" ] && [ "${_dur:-0}" -lt "$((_sum / 2))" ] && warn "File is much shorter than the source ($_dur s vs ~$_sum s) - the shard likely rate-limited the download; try again."
                    fi
                    return 0
                    ;;
            esac
            ;;
        *)
            # shellcheck disable=SC2086
            aria2c --referer="$_dl_refr" --enable-rpc=false --check-certificate=false --continue $iSH_DownFix --summary-interval=0 -x 16 -s 16 "$1" --dir="$download_dir" -o "$2.mp4" --download-result=hide
            ;;
    esac
}

android_mpv() {
    dir="/storage/emulated/0/mpv"
    file="$dir/mpv.config.mp4"
    if [ -w "${dir%*/mpv}" ]; then
        [ -d "${dir}" ] || mkdir "${dir}"
        printf "%s" "$3" | sed 's| --|\n|g; s|^--||g' >"$file"
    fi
    am start --user 0 -a android.intent.action.VIEW -d "$1" -n is.xyz.mpv/.MPVActivity -e "title" "$2" >/dev/null 2>&1
    unset dir file
}

play_episode() {
    _mpv_pid=""
    [ "$log_episode" = 1 ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && command -v logger >/dev/null && logger -t ani-cli "${anime_title}${ep_no}"
    if [ "$skip_intro" = 1 ]; then
        if [ -n "$mal_id" ]; then
            skip_flag="$(ani-skip -i "$mal_id" -e "$ep_no")"
        else
            warn "Couldn't find the MyAnimeList id of this anime, intro skipping disabled"
        fi
    fi
    [ -z "$episode" ] && get_episode_url

    # wait for the previous player to close before starting a new one
    wait 2>/dev/null

    # resume position
    _resume_pos=""
    if [ "$resume_enabled" = 1 ]; then
        _resume_pos=$(resume_episode "$id")
        [ -n "$_resume_pos" ] && [ "$_resume_pos" != "0" ] && warn "Resuming from $_resume_pos seconds..."
    fi

    # mpv socket for position tracking
    _mpv_socket=""
    case "$player_function" in
        mpv*|flatpak_mpv)
            _mpv_socket="/tmp/ani-cli-mpv-$$"
            ;;
    esac

    # shellcheck disable=SC2086
    case "$player_function" in
        debug)
            printf "All links:\n%s\nSelected link:\n" "$links"
            printf "%s\n" "$episode"
            ;;
        mpv*)
            _mpv_args=""
            [ -n "$_mpv_socket" ] && rm -f "$_mpv_socket"
            [ -n "$_mpv_socket" ] && _mpv_args="--input-ipc-server=$_mpv_socket"
            [ -n "$_resume_pos" ] && [ "$_resume_pos" != "0" ] && _mpv_args="$_mpv_args --start=$_resume_pos"
            if [ "$no_detach" = 0 ]; then
                nohup $player_function $_mpv_args $skip_flag --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" "$episode" $refr_flag $bacc_flag $player_extra_flags >/dev/null 2>&1 &
                _mpv_pid=$!
            else
                $player_function $_mpv_args $skip_flag $refr_flag $bacc_flag --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" "$episode" $player_extra_flags
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$range" ] && exit "$mpv_exitcode"
            fi
            ;;
        android_mpv) "$player_function" "$episode" "${anime_title} Episode ${ep_no}" "--tls-verify=no $refr_flag $bacc_flag" $player_extra_flags 2>&1 & ;;
        android_vlc) nohup am start --user 0 -a android.intent.action.VIEW -d "$episode" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 & ;;
        *iina*)
            _iina_refr_flag=""
            [ -n "$refr_flag" ] && _iina_refr_flag="--mpv-${refr_flag#--}"
            if pgrep -f "IINA" >/dev/null 2>&1; then
                nohup $player_function --no-stdin --mpv-tls-verify=no --mpv-force-media-title="${anime_title} Episode ${ep_no}" $_iina_refr_flag "$episode" $player_extra_flags >/dev/null 2>&1 &
            else
                nohup $player_function --no-stdin --mpv-tls-verify=no --keep-running --mpv-force-media-title="${anime_title} Episode ${ep_no}" $_iina_refr_flag "$episode" $player_extra_flags >/dev/null 2>&1 &
            fi
            ;;
        flatpak_mpv)
            _flatpak_args=""
            [ -n "$_mpv_socket" ] && _flatpak_args="--input-ipc-server=$_mpv_socket"
            [ -n "$_resume_pos" ] && [ "$_resume_pos" != "0" ] && _flatpak_args="$_flatpak_args --start=$_resume_pos"
            nohup flatpak run io.mpv.Mpv $_flatpak_args --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" "$episode" $refr_flag $bacc_flag $player_extra_flags >/dev/null 2>&1 &
            _mpv_pid=$!
            ;;
        vlc*) nohup $player_function --http-referrer="${refr_flag#--referrer=}" --play-and-exit --meta-title="${anime_title} Episode ${ep_no}" "$episode" $player_extra_flags >/dev/null 2>&1 & ;;
        *yncpla*) nohup $player_function "$episode" $player_extra_flags -- --tls-verify=no --force-media-title="${anime_title} Episode ${ep_no}" $refr_flag >/dev/null 2>&1 & ;;
        download) "$player_function" "$episode" "${anime_title} Episode ${ep_no}" $player_extra_flags ;;
        catt) nohup catt cast "$episode" $player_extra_flags >/dev/null 2>&1 & ;;
        iSH)
            printf "\e]8;;vlc://%s\a~~~~~~~~~~~~~~~~~~~~\n~ Tap to open VLC ~\n~~~~~~~~~~~~~~~~~~~~\e]8;;\a\n" "$episode"
            sleep 5
            ;;
        *) nohup $player_function "$episode" $player_extra_flags >/dev/null 2>&1 & ;;
    esac
    replay="$episode"
    unset episode

    # save playback position
    case "$player_function" in
        mpv*|flatpak_mpv)
            if [ "$menu_program" != "fzf" ]; then
                _final_pos=0
                _wait_pid=""
                case "$no_detach" in
                    0) _wait_pid="$_mpv_pid" ;;
                    1) _final_pos="$(get_mpv_position)" ;;  # foreground: mpv already returned, grab once
                esac
                while [ -n "$_wait_pid" ] && kill -0 "$_wait_pid" 2>/dev/null; do
                    _pos=$(get_mpv_position)
                    [ -n "$_pos" ] && [ "$_pos" != "0" ] && _final_pos=$_pos
                    sleep 2
                done
                update_history "$_final_pos"
            fi
            ;;
        *)
            update_history "0"
            ;;
    esac
    [ "$menu_program" != "fzf" ] && wait
}

play() {
    start=$(printf "%s" "$ep_no" | grep -Eo '^(-1|[0-9]+(\.[0-9]+)?)')
    end=$(printf "%s" "$ep_no" | grep -Eo '(-1|[0-9]+(\.[0-9]+)?)$')
    [ "$start" = "-1" ] && ep_no=$(printf "%s" "$ep_list" | tail -n1) && unset start
    [ -z "$end" ] || [ "$end" = "$start" ] && unset start end
    [ "$end" = "-1" ] && end=$(printf "%s" "$ep_list" | tail -n1)
    line_count=$(printf "%s\n" "$ep_no" | wc -l | tr -d "[:space:]")
    if [ "$line_count" != 1 ] || [ -n "$start" ]; then
        [ -z "$start" ] && start=$(printf "%s\n" "$ep_no" | head -n1)
        [ -z "$end" ] && end=$(printf "%s\n" "$ep_no" | tail -n1)
        range=$(printf "%s\n" "$ep_list" | sed -nE "/^${start}\$/,/^${end}\$/p")
        [ -z "$range" ] && die "Invalid range!"

        # batch download progress
        if [ "$batch_mode" = 1 ]; then
            _total=$(printf "%s\n" "$range" | wc -l | tr -d " ")
            _count=0
        fi

        for i in $range; do
            tput clear 2>/dev/null
            ep_no=$i
            if [ "$batch_mode" = 1 ]; then
                _count=$((_count + 1))
                printf "\33[2K\r\033[1;34m[%s/%s] Downloading episode %s...\033[0m\n" "$_count" "$_total" "$ep_no"
                # skip if already downloaded
                _fname="${anime_title} Episode ${ep_no}.mp4"
                if [ -f "$download_dir/$_fname" ]; then
                    printf "\33[2K\r\033[1;33mSkipping episode %s (already exists)\033[0m\n" "$ep_no"
                    continue
                fi
            else
                info "Playing episode $ep_no..."
            fi
            [ "$i" = "$end" ] && unset range
            play_episode
        done
    else
        play_episode
    fi
    # moves up to stored position and deletes to end
    [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && tput rc 2>/dev/null && tput ed 2>/dev/null
}

# MAIN

# setup
agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:150.0) Gecko/20100101 Firefox/150.0"

# browser-ish transport, no curl-impersonate needed
ciphers='ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305'
tls13_ciphers='TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256'
curl_exe=$(dep_ch_failover "curl_chrome136,curl_firefox135,curl_ff117,curl") || die "Program curl not found"
mode="${ANI_CLI_MODE:-sub}"
download_dir="${ANI_CLI_DOWNLOAD_DIR:-.}"
log_episode="${ANI_CLI_LOG:-1}"
quality="${ANI_CLI_QUALITY:-best}"
bacc_flag=""
refr_flag=""
case "$(uname -a | cut -d " " -f 1,3-)" in
    *Darwin*) player_function="${ANI_CLI_PLAYER:-$(where_iina)}" ;;   # mac OS
    *ndroid*) player_function="${ANI_CLI_PLAYER:-android_mpv}" ;;     # Android OS (termux)
    *MINGW* | *WSL2*) player_function="${ANI_CLI_PLAYER:-mpv.exe}" ;; # Windows OS
    *ish*) player_function="${ANI_CLI_PLAYER:-iSH}" ;;                # iOS (iSH)
    *) player_function="${ANI_CLI_PLAYER:-$(where_mpv)}" ;;           # Linux OS
esac

player_extra_flags="${ANI_CLI_PLAYER_FLAGS:-}"
no_detach="${ANI_CLI_NO_DETACH:-0}"
exit_after_play="${ANI_CLI_EXIT_AFTER_PLAY:-0}"
skip_intro="${ANI_CLI_SKIP_INTRO:-0}"
menu_program="${ANI_CLI_MENU:-fzf}"
menu_extra_flags="${ANI_CLI_MENU_FLAGS:-}"

if [ ! -t 0 ]; then
    if command -v rofi >/dev/null 2>&1; then
        menu_program=rofi
    elif command -v dmenu >/dev/null 2>&1; then
        menu_program=dmenu
    fi
fi

hist_dir="${ANI_CLI_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ani-cli}"
[ ! -d "$hist_dir" ] && mkdir -p "$hist_dir"
histfile="$hist_dir/ani-hsts"
[ ! -f "$histfile" ] && : >"$histfile"
search="search"
branch="${ANI_CLI_BRANCH:-master}"
resume_enabled=0
batch_mode=0
skip_flag=""
iSH_DownFix=""
mal_id=""

while [ $# -gt 0 ]; do
    case "$1" in
        -v | --vlc)
            case "$(uname -a | cut -d " " -f 1,3-)" in
                *ndroid*) player_function="android_vlc" ;;
                MINGW* | *WSL2*) player_function="vlc.exe" ;;
                *ish*) player_function="iSH" ;;
                *) player_function="vlc" ;;
            esac
            ;;
        -s | --syncplay)
            case "$(uname -s)" in
                Darwin*) player_function="/Applications/Syncplay.app/Contents/MacOS/syncplay" ;;
                MINGW* | *Msys)
                    export PATH="$PATH":"/c/Program Files (x86)/Syncplay/"
                    player_function="syncplay.exe"
                    ;;
                *) player_function="syncplay" ;;
            esac
            ;;
        -q | --quality)
            [ $# -lt 2 ] && die "missing argument!"
            quality="$2"
            shift
            ;;
        -S | --select-nth)
            [ $# -lt 2 ] && die "missing argument!"
            index="$2"
            shift
            ;;
        -c | --continue) search=history ;;
        --resume) resume_enabled=1 ;;
        --batch)
            [ "$player_function" = "iSH" ] && iSH_DownFix="--async-dns=false"
            player_function=download
            batch_mode=1
            ;;
        -d | --download)
            [ "$player_function" = "iSH" ] && iSH_DownFix="--async-dns=false"
            player_function=download
            ;;
        -D | --delete)
            : >"$histfile"
            exit 0
            ;;
        -l | --logview)
            case "$(uname -s)" in
                Darwin*) log show --predicate 'process == "logger"' ;;
                Linux*) journalctl -t ani-cli ;;
                *) die "Logger not implemented for your platform" ;;
            esac
            exit 0
            ;;
        -V | --version) version_info ;;
        -h | --help) help_info ;;
        -e | --episode | -r | --range)
            [ $# -lt 2 ] && die "missing argument!"
            printf "%s" "$2" | grep -qE '[^0-9. -]' && die "Invalid episode number(s): $2"
            ep_no="$2"
            shift
            ;;
        --dub) mode="dub" ;;
        --no-detach) no_detach=1 ;;
        --exit-after-play) exit_after_play=1; no_detach=1 ;;
        --rofi) menu_program=rofi ;;
        --dmenu) menu_program=dmenu ;;
        --skip) skip_intro=1 ;;
        -N | --nextep-countdown) search=nextep ;;
        -U | --update)
            dep_ch "patch"
            if [ $# -gt 1 ]; then
                case "$2" in
                    -*) ;;
                    *) branch="$2" ;;
                esac
            fi
            update_script
            ;;
        *) query="$(printf "%s" "$query $1" | sed "s|^ ||")" ;;
    esac
    shift
done
[ "$menu_program" = "fzf" ] && menu_multi_flag="-m"
[ "$menu_program" = "rofi" ] && menu_multi_flag="-multi-select"

info "Using provider: anineko"

info "Checking dependencies..."
dep_ch "sed"
dep_ch "grep"
[ "$skip_intro" = 1 ] && dep_ch "ani-skip"
dep_ch "$menu_program"
case "$player_function" in
    debug) ;;
    download) dep_ch_failover "yt-dlp,ffmpeg" >/dev/null || die 'Neither yt-dlp nor ffmpeg found' ;;
    android*) printf "\33[2K\rChecking of players on Android is disabled.\n" ;;
    *iSH*) printf "\33[2K\rChecking of players on iOS is disabled\n" ;;
    mpv|flatpak_mpv) dep_ch "socat" ;;
    *) dep_ch "$player_function" ;;
esac

trap 'save_position_and_cleanup; exit 1' INT HUP TERM

# searching
case "$search" in
    history)
        backup_old_hist
        # refresh entries concurrently but throttled, to avoid hammering the api
        anime_list=$(
            _n=0
            while IFS='	' read -r ep_no id title _pos; do
                process_hist_entry &
                _n=$((_n + 1))
                [ $((_n % 4)) -eq 0 ] && wait
            done <"$histfile"
            wait
        )
        [ -z "$anime_list" ] && die "No unwatched series in history!"
        [ -z "${index##*[!0-9]*}" ] && id=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: " | cut -f1)
        [ -z "${index##*[!0-9]*}" ] || id=$(printf "%s" "$anime_list" | sed -n "${index}p" | cut -f1)
        [ -z "$id" ] && exit 1
        title=$(printf "%s" "$anime_list" | grep -F "$id" | cut -f2 | sed 's/ - episode.*//')
        ep_list=$(episodes_list_anineko "$id")
        ep_no=$(printf "%s" "$anime_list" | grep -F "$id" | cut -f2 | sed -nE 's/.*- episode (.+)$/\1/p')
        anime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
        anineko_desc "$id" || true
        printf "%s" "$anime_list" | grep -F "$id" | cut -f2 | grep -q "(up to date)" && time_until_next_ep "$anime_title"
        ;;
    *)
        if [ "$menu_program" = "fzf" ]; then
            while [ -z "$query" ]; do
                printf "\33[2K\r\033[1;36mSearch anime: \033[0m" && read -r query
            done
        else
            [ -z "$query" ] && query=$(: | menu "Search anime: " "" "$menu_extra_flags")
            [ -z "$query" ] && exit 1
        fi
        # for checking new releases by specifying anime name
        [ "$search" = "nextep" ] && time_until_next_ep "$query"

        anime_list=$(search_anineko "$query")
        [ -z "$anime_list" ] && die "No results found!"
        # check if select-nth index is a valid number, if so skip interactive selection
        [ "$index" -eq "$index" ] 2>/dev/null && result=$(printf "%s" "$anime_list" | sed -n "${index}p")
        [ -z "$index" ] && result=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: ")
        [ -z "$result" ] && die "Invalid/No Anime Selection"
        title="$(printf "%s" "$result" | cut -f2)"
        anime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
        id="$(printf "%s" "$result" | cut -f1)"
        anineko_desc "$(printf "%s" "$result" | cut -f1)" || true
        ep_list=$(episodes_list_anineko "$id")
        # -1 (last episode) is always valid; ranges/multiples/decimals are validated by play()
        if [ -n "$ep_no" ] && [ "$ep_no" != "-1" ]; then
            case "$ep_no" in
                *[!0-9]*) ;;                       # range/multi/non-whole: checked in play()
                *) printf "%s" "$ep_list" | grep -q "^$ep_no$" || die "Invalid Episode Selection" ;;
            esac
        fi
        [ -z "$ep_no" ] && ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag")
        [ -z "$ep_no" ] && die "Invalid/No Episode Selection"
        ;;
esac

# moves the cursor up one line and clears that line
tput cuu1 2>/dev/null && tput el 2>/dev/null
# stores the position of cursor
tput sc 2>/dev/null

# playback & loop
play
[ "$player_function" = "download" ] && exit 0
[ "$player_function" = "debug" ] && exit 0

while cmd=$(printf 'next\nreplay\nprevious\nselect%s\nchange_quality\nquit' "$seasons_option" | nth "Playing episode $ep_no of $title... "); do
    # save playback position before acting on the menu choice
    if [ "$menu_program" = "fzf" ]; then
        case "$player_function" in
            mpv*|flatpak_mpv) update_history "$(get_mpv_position)" ;;
        esac
    fi
    case "$cmd" in
        next) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}" 2>/dev/null) ;;
        replay) episode="$replay" ;;
        previous) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h" 2>/dev/null) ;;
        select) ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag") ;;
        seasons)
            new_anime="$(printf "%s" "$seasons" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: ")"
            [ -z "$new_anime" ] && die "Invalid/No Anime Selection"
            title="$(printf "%s" "$new_anime" | cut -f2)"
            anime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
            id="$(printf "%s" "$new_anime" | cut -f1)"
            anineko_desc "$id" || true
            ep_list=$(episodes_list_anineko "$id")
            ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag")
            [ -z "$ep_no" ] && die "Invalid/No Episode Selection"
            ;;

        change_quality)
            new_quality="$(printf "%s" "$links" | menu | cut -d">" -f1)"
            [ -z "$new_quality" ] && die "No quality selected"
            select_quality "$new_quality"
            ;;
        *)
            cleanup
            exit 0
            ;;
    esac
    [ -z "$ep_no" ] && die "Out of range"
    play
done
cleanup

